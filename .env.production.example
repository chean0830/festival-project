# Copy to .env on the server and fill in real values. .env is git-ignored.
#   cp .env.production.example .env

# ---- Public domain -----------------------------------------------------------
# The duckdns (or custom) domain pointing at this VM. No scheme, no trailing slash.
APP_DOMAIN=yourname.duckdns.org

# ---- Database --------------------------------------------------------------
# Used as the MySQL root password AND by the backend to connect. Pick a strong one.
# DB_URL / DB_USERNAME are set by docker-compose; only the password lives here.
DB_PASSWORD=change-me-strong

# ---- OAuth clients ------------------------------------------------------------
# Register redirect URI https://${APP_DOMAIN}/login/oauth2/code/<provider> in each console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- Mail (password reset, notifications) -----------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Festlog

# ---- LiveKit Cloud (live streaming) ----------------------------------------
LIVE_PROVIDER=LIVEKIT
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Payments (Toss) -------------------------------------------------------
TOSS_SECRET_KEY=

# ---- AI (Gemini) — used by both backend and ai-proxy ----------------------
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite

# ---- External APIs -------------------------------------------------------
OPENWEATHER_API_KEY=
KAKAO_LOCAL_API_KEY=

# ---- Frontend build-time keys (baked into the JS bundle) ------------------
VITE_KAKAO_JS_KEY=
VITE_TOSS_CLIENT_KEY=
