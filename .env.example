# Database
DB_URL=jdbc:mysql://localhost:3306/festival?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me

# Existing Google login OAuth client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LiveKit Cloud > Project Settings > Keys
# API Secret은 React/VITE 환경변수에 넣지 않고 Spring Boot에서만 사용한다.
LIVE_PROVIDER=LOCAL
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Toss Payments 테스트 결제 승인용 서버 키 (프론트엔드에 노출 금지)
TOSS_SECRET_KEY=your-toss-test-secret-key
