# Database
DB_URL=jdbc:mysql://localhost:3306/festival?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=change-me

# Existing Google login OAuth client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube Live Streaming API
# Google 로그인과 같은 OAuth 클라이언트를 사용해도 된다.
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/oauth/callback
# `openssl rand -base64 32` 명령으로 생성한다. 실제 값은 팀 보안 채널로만 공유한다.
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
